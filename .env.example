# AttendX Frontend Environment Variables
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local` files containing real secrets to Git.

# Supabase Project URL (found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for client-side browser usage)
# DO NOT place the `service_role` key here. The service_role key bypasses Row Level Security
# and must NEVER be exposed in client code.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration
VITE_APP_NAME="AttendX"
VITE_APP_ENV="development"
